# Topmost EditorConfig file; stops the search in parent directories
root = true

# Global defaults for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 120

# Specific languages or file modifications
[*.{json,yaml,yml,lua,svelte,nix}]
indent_size = 2
tab_width = 2

[*.py]
indent_size = 4
max_line_length = 79

# Use hard tabs for Makefiles
[{Makefile,**.mk}]
indent_style = tab
indent_size = 4
